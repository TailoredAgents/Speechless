# Public site URL used for canonical metadata and sitemap generation.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Optional locally. Required for persistent deployed data.
DATABASE_URL=

# Generate at least 32 random characters for production.
SESSION_SECRET=

# Single-admin bootstrap. The password is hashed into PostgreSQL on first successful login.
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Commerce remains disabled until a reviewed provider adapter is connected.
COMMERCE_PROVIDER=disabled
